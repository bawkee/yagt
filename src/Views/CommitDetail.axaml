<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.CommitDetail"
             x:DataType="vm:CommitDetail"
             x:Name="ThisControl">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:CommitSubjectMatch" x:DataType="vm:CommitSubjectMatch">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding BranchNames}" TextWrapping="Wrap"/>
        <Button Classes="icon_button" Padding="0" HorizontalAlignment="Left" Cursor="Hand"
                IsVisible="{Binding HasMoreBranches}" Click="OnShowAllSubjectMatchBranchesClicked">
          <TextBlock Text="{Binding RemainingBranchCount, Converter={x:Static c:StringConverters.FormatByResourceKey}, ConverterParameter=CommitDetail.Info.SubjectMatches.ShowMoreBranches}"
                     Foreground="{DynamicResource Brush.Link}" TextDecorations="Underline" TextWrapping="Wrap"/>
        </Button>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <TabControl SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}" Padding="0,4">
    <!-- Information Page -->
    <TabItem>
      <TabItem.Header>
        <Border Background="Transparent" PointerPressed="OnTabHeaderPointerPressed">
          <TextBlock Classes="tab_header" Text="{DynamicResource Text.CommitDetail.Info}"/>
        </Border>
      </TabItem.Header>

      <ScrollViewer Margin="4,0,0,0"
                    Offset="{Binding ScrollOffset, Mode=TwoWay}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding #ThisControl.IsDetailsPanelExpanded, Mode=OneWay}">
        <StackPanel Orientation="Vertical">
          <!-- Base Information -->
          <v:CommitBaseInfo Content="{Binding Commit}"
                            FullMessage="{Binding FullMessage}"
                            SignInfo="{Binding SignInfo}"
                            WebLinks="{Binding WebLinks}"
                            Margin="0,0,12,0"/>

          <StackPanel Margin="12,12,12,4" Spacing="8" IsVisible="{Binding SubjectMatches.IsEnabled}">
            <TextBlock Classes="group_header_label" Text="{DynamicResource Text.CommitDetail.Info.SubjectMatches}"/>
            <TextBlock Text="{DynamicResource Text.CommitDetail.Info.SubjectMatches.Tip}"
                       Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource Text.CommitDetail.Info.SubjectMatches.Loading}"
                       Foreground="{DynamicResource Brush.FG2}" IsVisible="{Binding SubjectMatches.IsLoading}"/>
            <TextBlock Text="{DynamicResource Text.CommitDetail.Info.SubjectMatches.Empty}"
                       Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" IsVisible="{Binding SubjectMatches.IsEmpty}"/>
            <TextBlock Text="{DynamicResource Text.CommitDetail.Info.SubjectMatches.Failed}"
                       Foreground="{DynamicResource Brush.FG2}" IsVisible="{Binding SubjectMatches.HasFailed}"/>
            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding SubjectMatches.SelectedCommit.HasBranches}">
              <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.FG2}"
                         Text="{DynamicResource Text.CommitDetail.Info.SubjectMatches.SelectedCommit}"/>
              <ContentControl Grid.Column="1" Content="{Binding SubjectMatches.SelectedCommit}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding SubjectMatches.Matches}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CommitSubjectMatch" x:DataType="vm:CommitSubjectMatch">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                    <Button Grid.Column="0" Classes="icon_button" Padding="0" Margin="0,0,12,0"
                            Click="OnSubjectMatchClicked" ToolTip.Tip="{Binding SHA}" VerticalAlignment="Top">
                      <TextBlock Text="{Binding SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                                 FontFamily="{DynamicResource Fonts.Monospace}" Foreground="DarkOrange" TextDecorations="Underline"/>
                    </Button>
                    <ContentControl Grid.Column="1" Content="{Binding}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{DynamicResource Text.CommitDetail.Info.SubjectMatches.Truncated}"
                       Foreground="{DynamicResource Brush.FG2}" IsVisible="{Binding SubjectMatches.IsTruncated}"/>
          </StackPanel>

          <!-- Line -->
          <Rectangle Height=".65" Margin="8,8,12,8" Fill="{DynamicResource Brush.Border2}"/>

          <!-- Change List -->
          <ListBox Background="Transparent"
                   Margin="64,0,12,4"
                   SelectionMode="Single"
                   ItemsSource="{Binding Changes, Converter={x:Static c:ListConverters.Top100Changes}}"
                   KeyDown="OnCommitListKeyDown">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="CornerRadius" Value="4"/>
              </Style>
            </ListBox.Styles>

            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
              <DataTemplate DataType="m:Change">
                <Grid Background="Transparent" Height="24" ColumnDefinitions="36,*" ContextRequested="OnChangeContextRequested" DoubleTapped="OnChangeDoubleTapped">
                  <ToolTip.Tip>
                    <TextBlock TextWrapping="Wrap">
                      <Run Text="{Binding Path, Mode=OneWay}"/>
                      <Run Text=" • " Foreground="Gray"/>
                      <Run Text="{Binding IndexDesc, Mode=OneWay}" Foreground="Gray"/>
                    </TextBlock>
                  </ToolTip.Tip>

                  <v:ChangeStatusIcon Grid.Column="0"
                                      Width="14" Height="14"
                                      HorizontalAlignment="Left"
                                      Margin="16,0,0,0"
                                      Change="{Binding}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Path}" Margin="8,0" HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Only Top100 Tip -->
          <TextBlock Margin="108,0,12,16"
                     Text="{DynamicResource Text.CommitDetail.Info.GotoChangesPage}"
                     Foreground="{DynamicResource Brush.FG2}"
                     IsVisible="{Binding Changes, Converter={x:Static c:ListConverters.IsOnlyTop100Shows}}"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem>
      <TabItem.Header>
        <Border Background="Transparent" PointerPressed="OnTabHeaderPointerPressed">
          <TextBlock Classes="tab_header" Text="{DynamicResource Text.CommitDetail.Changes}"/>
        </Border>
      </TabItem.Header>
      <v:CommitChanges Margin="4,0"
                       IsVisible="{Binding #ThisControl.IsDetailsPanelExpanded, Mode=OneWay}"/>
    </TabItem>

    <TabItem>
      <TabItem.Header>
        <Border Background="Transparent" PointerPressed="OnTabHeaderPointerPressed">
          <TextBlock Classes="tab_header" Text="{DynamicResource Text.CommitDetail.Files}"/>
        </Border>
      </TabItem.Header>
      <v:RevisionFiles Margin="4,0"
                       IsVisible="{Binding #ThisControl.IsDetailsPanelExpanded, Mode=OneWay}"/>
    </TabItem>
  </TabControl>
</UserControl>
