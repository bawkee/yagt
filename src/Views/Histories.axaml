<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.Histories"
             x:DataType="vm:Histories"
             x:Name="ThisControl">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            x:Name="HistoryFocusBar"
            Padding="8,4"
            Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Border0}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding IsBranchHistoryMode}">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer Grid.Column="0"
                      Margin="0,0,6,0"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="HistoryBranchesPanel" Orientation="Horizontal" Spacing="6">
            <Border x:Name="SelectedHistoryBranchChip"
                    Height="26"
                    Padding="6,0"
                    CornerRadius="3"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border2}"
                    ToolTip.Tip="{Binding HistoryScopeDescription}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Branch}"/>
                <TextBlock Text="{Binding HistoryBranchName}"
                           MaxWidth="240"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>

            <Border x:Name="IncludedCurrentHistoryBranchChip"
                    Height="26"
                    Padding="6,0,0,0"
                    CornerRadius="3"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border2}"
                    IsVisible="{Binding ShowIncludedCurrentHistoryBranch}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Check}"/>
                <TextBlock Text="{Binding IncludedCurrentHistoryBranchName}"
                           MaxWidth="240"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding IncludedCurrentHistoryBranchName}"/>
                <Button Classes="icon_button"
                        Width="24" Height="24"
                        Click="OnRemoveCurrentHistoryBranch"
                        ToolTip.Tip="{DynamicResource Text.Histories.RemoveBranch}">
                  <Path Width="8" Height="8" Data="{StaticResource Icons.Close}"/>
                </Button>
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding AdditionalHistoryBranches}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="m:Branch" x:DataType="m:Branch">
                  <Border Height="26"
                          Padding="6,0,0,0"
                          CornerRadius="3"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource Brush.Border2}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Path Width="12" Height="12" Data="{StaticResource Icons.Branch}"/>
                      <TextBlock Text="{Binding FriendlyName}"
                                 MaxWidth="240"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding FriendlyName}"/>
                      <Button Classes="icon_button"
                              Width="24" Height="24"
                              Click="OnRemoveHistoryBranch"
                              ToolTip.Tip="{DynamicResource Text.Histories.RemoveBranch}">
                        <Path Width="8" Height="8" Data="{StaticResource Icons.Close}"/>
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Button Grid.Column="1"
                x:Name="AddHistoryBranchButton"
                Classes="flat"
                Height="26"
                Padding="8,0"
                Click="OnAddHistoryBranch">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Plus}"/>
            <TextBlock Text="{DynamicResource Text.Histories.AddBranch}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <v:HistoriesCommitList Grid.Row="1"
                           x:Name="CommitListContainer"
                           Classes="static_scrollbar"
                           ScrollViewer.AllowAutoHide="False"
                           Background="Transparent"
                           ItemsSource="{Binding Commits, Mode=OneWay}"
                           TotalCommits="{Binding Commits.Count, Mode=OneWay}"
                           SelectedCommits="{Binding SelectedCommits, Mode=TwoWay}"
                           ColumnHeaderHeight="24"
                           RowHeight="26"
                           LayoutUpdated="OnCommitListLayoutUpdated"
                           ContextRequested="OnCommitListContextRequested"
                           DoubleTapped="OnCommitListDoubleTapped">
      <DataGrid.Styles>
        <Style Selector="DataGrid.static_scrollbar">
          <Style Selector="^ /template/ DataGridRowsPresenter#PART_RowsPresenter">
            <Setter Property="Grid.RowSpan" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Background" Value="{DynamicResource Brush.Contents}"/>
          </Style>
          <Style Selector="^ /template/ DataGridColumnHeadersPresenter#PART_ColumnHeadersPresenter">
            <Setter Property="Grid.Column" Value="0" />
          </Style>
          <Style Selector="^ /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
            <Setter Property="Fill" Value="{DynamicResource Brush.Border0}"/>
            <Setter Property="Height" Value="0.65"/>
          </Style>
          <Style Selector="^ /template/ ScrollBar">
            <Setter Property="Background" Value="{DynamicResource Brush.Contents}"/>
          </Style>
        </Style>

        <Style Selector="DataGridColumnHeader">
          <Setter Property="MinHeight" Value="24"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Template">
            <ControlTemplate>
              <Border x:Name="HeaderBorder"
                      Background="{TemplateBinding Background}"
                      BorderThickness="0"
                      CornerRadius="0">
                <Grid ColumnDefinitions="*,4">
                  <ContentPresenter x:Name="PART_ContentPresenter"
                                    Grid.Column="0"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                  <Rectangle Name="VerticalSeparator"
                             Grid.Column="1"
                             Width="1"
                             HorizontalAlignment="Center" VerticalAlignment="Stretch"
                             Fill="{DynamicResource Brush.Border0}"
                             IsVisible="{TemplateBinding AreSeparatorsVisible}" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter>

          <Style Selector="^:nth-child(5)">
            <Setter Property="AreSeparatorsVisible" Value="False"/>
          </Style>
        </Style>

        <Style Selector="DataGridCell">
          <Setter Property="Template">
            <ControlTemplate>
              <Grid x:Name="PART_CellRoot">
                <ContentPresenter Margin="0"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </ControlTemplate>
          </Setter>
        </Style>
      </DataGrid.Styles>

      <DataGrid.Columns>
        <DataGridTemplateColumn Width="*" IsReadOnly="True">
          <DataGridTemplateColumn.Header>
            <Border Padding="48,0">
              <TextBlock Classes="table_header" Text="{DynamicResource Text.Histories.Header.GraphAndSubject}" HorizontalAlignment="Center"/>
            </Border>
          </DataGridTemplateColumn.Header>

          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="m:Commit">
              <Border Padding="{Binding LeftMargin, Converter={x:Static c:DoubleConverters.ToLeftMargin}}"
                      ClipToBounds="True"
                      Classes.same_subject="{Binding IsSameSubjectMatch}">
                <Border.Styles>
                  <Style Selector="Border:not(.same_subject)">
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                  <Style Selector="Border.same_subject">
                    <Setter Property="Background" Value="{DynamicResource Brush.CommitSubjectMatch}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                  </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="2,0,4,0" ClipToBounds="True">
                  <v:CommitStatusIndicator Grid.Column="0"
                                           CurrentBranch="{Binding $parent[v:Histories].CurrentBranch}"
                                           AheadBrush="{DynamicResource Brush.Accent}"
                                           BehindBrush="{DynamicResource Brush.FG1}"
                                           VerticalAlignment="Center"/>

                  <v:BisectStateIndicator Grid.Column="1"
                                          Background="{DynamicResource Brush.Contents}"
                                          Foreground="{DynamicResource Brush.FG1}"
                                          Bisect="{Binding $parent[v:Histories].Bisect}"
                                          VerticalAlignment="Center"/>

                  <v:CommitRefsPresenter Grid.Column="2"
                                         Background="{DynamicResource Brush.Contents}"
                                         Foreground="{DynamicResource Brush.FG1}"
                                         ShowTags="{Binding Source={x:Static vm:Preferences.Instance}, Path=ShowTagsInGraph}"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         UseGraphColor="{Binding IsHighlightedInGraph, Mode=OneWay}"
                                         UseCompactBranchNames="{Binding Source={x:Static vm:Preferences.Instance}, Path=UseCompactBranchNamesInGraph}"
                                         HasSingleRemote="{Binding $parent[v:Histories].HasSingleRemote}"/>

                  <v:CommitSubjectPresenter Grid.Column="3"
                                            Height="26"
                                            FontFamily="{DynamicResource Fonts.Default}"
                                            FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=DefaultFontSize}"
                                            CodeFontFamily="{DynamicResource Fonts.Monospace}"
                                            InlineCodeBackground="{DynamicResource Brush.InlineCode}"
                                            InlineCodeForeground="{DynamicResource Brush.InlineCodeFG}"
                                            Foreground="{DynamicResource Brush.FG1}"
                                            LinkForeground="{DynamicResource Brush.Link}"
                                            Subject="{Binding Subject}"
                                            IssueTrackers="{Binding $parent[v:Histories].IssueTrackers}"
                                            FontWeight="{Binding IsCurrentHead, Converter={x:Static c:BoolConverters.IsBoldToFontWeight}}"
                                            Opacity="{Binding HistoryOpacity}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn MinWidth="80" IsReadOnly="True" IsVisible="{Binding IsAuthorColumnVisible, Mode=OneWay}">
          <DataGridTemplateColumn.Header>
            <TextBlock Classes="table_header" Text="{DynamicResource Text.Histories.Header.Author}" HorizontalAlignment="Center"/>
          </DataGridTemplateColumn.Header>

          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="m:Commit">
              <Grid ColumnDefinitions="20,*" Background="Transparent">
                <v:Avatar Grid.Column="0"
                          Width="16" Height="16"
                          Margin="4,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          User="{Binding Author}"
                          Opacity="{Binding HistoryOpacity}"
                          IsHitTestVisible="False"/>

                <Border Grid.Column="1" Padding="8,0" ClipToBounds="True">
                  <TextBlock Text="{Binding Author.Name}"
                             FontWeight="{Binding IsCurrentHead, Converter={x:Static c:BoolConverters.IsBoldToFontWeight}}"
                             Opacity="{Binding HistoryOpacity}"
                             HorizontalAlignment="Left"/>
                </Border>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn MinWidth="100" IsReadOnly="True" IsVisible="{Binding IsSHAColumnVisible, Mode=OneWay}">
          <DataGridTemplateColumn.Header>
            <TextBlock Classes="table_header" Text="{DynamicResource Text.Histories.Header.SHA}" HorizontalAlignment="Center"/>
          </DataGridTemplateColumn.Header>

          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="m:Commit">
              <Border Padding="8,0,0,0" Background="Transparent" ClipToBounds="True">
                <TextBlock Text="{Binding SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                           FontFamily="{DynamicResource Fonts.Monospace}"
                           FontWeight="{Binding IsCurrentHead, Converter={x:Static c:BoolConverters.IsBoldToFontWeight}}"
                           Opacity="{Binding HistoryOpacity}"/>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn MinWidth="160" IsReadOnly="True" IsVisible="{Binding IsAuthorTimeColumnVisible, Mode=OneWay}">
          <DataGridTemplateColumn.Header>
            <TextBlock Classes="table_header" Text="{DynamicResource Text.Histories.Header.AuthorTime}" HorizontalAlignment="Center"/>
          </DataGridTemplateColumn.Header>

          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="m:Commit">
              <Border Padding="8,0" Background="Transparent" ClipToBounds="True">
                <v:CommitTimeTextBlock FontFeatures="+tnum"
                                       FontWeight="{Binding IsCurrentHead, Converter={x:Static c:BoolConverters.IsBoldToFontWeight}}"
                                       Opacity="{Binding HistoryOpacity}"
                                       Timestamp="{Binding AuthorTime, Mode=OneWay}"
                                       ShowAsDateTime="{Binding Source={x:Static vm:Preferences.Instance}, Path=!DisplayTimeAsPeriodInHistories, Mode=OneWay}"
                                       DateTimeFormat="{Binding Source={x:Static vm:Preferences.Instance}, Path=DateTimeFormat, Mode=OneWay}"
                                       Use24Hours="{Binding Source={x:Static vm:Preferences.Instance}, Path=Use24Hours, Mode=OneWay}"/>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn MinWidth="160" IsReadOnly="True" IsVisible="{Binding IsCommitTimeColumnVisible, Mode=OneWay}">
          <DataGridTemplateColumn.Header>
            <TextBlock Classes="table_header" Text="{DynamicResource Text.Histories.Header.CommitTime}" HorizontalAlignment="Center"/>
          </DataGridTemplateColumn.Header>

          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="m:Commit">
              <Border Padding="8,0" Background="Transparent" ClipToBounds="True">
                <v:CommitTimeTextBlock FontWeight="{Binding IsCurrentHead, Converter={x:Static c:BoolConverters.IsBoldToFontWeight}}"
                                       FontFeatures="+tnum"
                                       Opacity="{Binding HistoryOpacity}"
                                       Timestamp="{Binding CommitterTime, Mode=OneWay}"
                                       ShowAsDateTime="{Binding Source={x:Static vm:Preferences.Instance}, Path=!DisplayTimeAsPeriodInHistories, Mode=OneWay}"
                                       DateTimeFormat="{Binding Source={x:Static vm:Preferences.Instance}, Path=DateTimeFormat, Mode=OneWay}"
                                       Use24Hours="{Binding Source={x:Static vm:Preferences.Instance}, Path=Use24Hours, Mode=OneWay}"/>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </v:HistoriesCommitList>

    <Border Grid.Row="1"
            Background="Transparent"
            Height="24"
            HorizontalAlignment="Stretch" VerticalAlignment="Top"
            PointerMoved="OnCommitListHeaderPointerMoved"
            PointerPressed="OnCommitListHeaderPointerPressed"
            PointerReleased="OnCommitListHeaderPointerReleased">
      <StackPanel Orientation="Horizontal"
                  Height="18"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center"
                  Spacing="6">
        <ToggleButton Classes="line_path" Width="18" IsChecked="{Binding IsSearchingCommits, Mode=TwoWay}">
          <ToolTip.Tip>
            <TextBlock>
              <Run Text="{DynamicResource Text.Repository.Search.ToolTip}" Foreground="{DynamicResource Brush.FG1}"/>
              <Run Text=" "/>
              <Run Text="{OnPlatform Ctrl+Shift+F, macOS=⌘+⇧+F}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            </TextBlock>
          </ToolTip.Tip>
          <Path Width="14" Height="14" Data="{StaticResource Icons.Search}"/>
        </ToggleButton>

        <Button x:Name="HistoryAdvancedOptionsButton"
                Classes="icon_button"
                Width="18" Height="18"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Click="OnOpenAdvancedOptions"
                ToolTip.Tip="{DynamicResource Text.Histories.AdvancedOptions}">
          <Path Width="12" Height="12"
                Data="{StaticResource Icons.Settings2}"/>
        </Button>
      </StackPanel>
    </Border>

    <v:CommitGraph Grid.Row="1"
                   x:Name="CommitGraph"
                   Margin="0,24,0,0"
                   Graph="{Binding Graph}"
                   DotBrush="{DynamicResource Brush.Contents}"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   IsHitTestVisible="False"
                   ClipToBounds="True"
                   Loaded="OnCommitGraphLoaded"/>

    <Border Grid.Row="1"
            Width="28" Height="28"
            Margin="0,0,16,8"
            CornerRadius="14"
            Background="{DynamicResource Brush.Popup}"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Effect="drop-shadow(0 0 8 #80000000)"
            PointerPressed="OnScrollToTopPointerPressed"
            IsVisible="{Binding $parent[v:Histories].IsScrollToTopVisible}">
      <Path Width="12" Height="12"
            Data="{StaticResource Icons.ScrollToTop}"
            Fill="{DynamicResource Brush.FG1}"
            Opacity=".8"/>
    </Border>

    <v:LoadingIcon Grid.Row="1" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}"/>
  </Grid>
</UserControl>
